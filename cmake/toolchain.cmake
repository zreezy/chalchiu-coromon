set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR i686)

add_compile_definitions(-DNTDDI_VERSION=0x0A000005)

# Coromon is a 32-bit game, so chalchiu has to be built for i686.
# Works with llvm-mingw (clang, preferred) or GNU mingw-w64 (gcc).

set(CHALCHIU_TOOLCHAIN_PREFIX "i686-w64-mingw32-" CACHE STRING "")

find_program(CHALCHIU_CXX NAMES ${CHALCHIU_TOOLCHAIN_PREFIX}clang++ ${CHALCHIU_TOOLCHAIN_PREFIX}c++ ${CHALCHIU_TOOLCHAIN_PREFIX}g++ REQUIRED)
find_program(CHALCHIU_CC  NAMES ${CHALCHIU_TOOLCHAIN_PREFIX}clang   ${CHALCHIU_TOOLCHAIN_PREFIX}gcc REQUIRED)

set(CMAKE_C_COMPILER   ${CHALCHIU_CC})
set(CMAKE_CXX_COMPILER ${CHALCHIU_CXX})

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
